# --- Android / Gradle ---
.gradle/
build/
/app/build/
/local.properties
captures/
*.iml

# --- Bubblewrap build outputs (land in repo root; not a release) ---
/app-release-signed.apk
/app-release-bundle.aab
/app-release-signed.apk.idsig
/app-release-unsigned-aligned.apk
/*-unsigned*.apk

# --- Signing / secrets (NEVER commit) ---
*.keystore
*.jks
*.keystore.base64
keystore-backup*
android.keystore

# --- Bubblewrap ---
.bubblewrap/
node_modules/
twa-manifest.json.bak

# --- JetBrains / Android Studio ---
/.idea/

# --- misc ---
*.log
.DS_Store

# autoloop: ephemeral run-state — never committed (durable state is in GitHub)
.claude/state/autoloop-cache.json
.claude/state/verify-result.json
.claude/state/work-queue.json
.claude/state/autoloop.lock

# --- live e2e (e2e/make_ca.sh): the throwaway CA and the debug-only trust in it ---
/e2e/out/
/e2e-out/
/app/src/debug/
