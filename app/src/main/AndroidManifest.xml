<?xml version="1.0" encoding="utf-8"?>
<!-- Haus (#176, laib ADR 0022): the start screen with the favorite devices,
     home-screen widgets and pairing, and the daily
     pick-up of the phone's message backups (#194, laib ADR 0029).
     One foreground service keeps the widgets live while the screen is on; no
     other notification, no poll, no web shell. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The live widgets (realtime/LiveService.kt): one specialUse foreground service,
         its notification (shown on Android 13+ only with the permission), its restart after boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exempt from battery optimization, the restart of the live service after its
         process died may go foreground on Android 12+ (asked once after pairing). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Kontakte, SMS und Anrufe (laib ADR 0029): optional, each asked for only when
         its switch on „Daten sichern“ is turned on; read only. On Android 13+
         a sideloaded app must first be allowed "restricted settings" for SMS and calls. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Standortverlauf (owner 2026-11-02): optional, asked for only when its switch is
         turned on. The location, in the background too („Immer zulassen“), from
         Android's own LocationManager (no Google Play services); the network state
         to know whether it is on a Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ package visibility: the Custom Tabs provider for pairing. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haus">

        <!-- The app's one screen: pairing, then the widgets. It also takes the
             redirect from Haus's /pair-device, cloud.dopp.haus://pair#token=….
             The setup QR is scanned in-app and has NO intent filter: a link
             from any web page could otherwise point the app at a foreign server. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/appName">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The share target of the assistant's sharing shortcut (#188). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cloud.dopp.haus" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- One device per widget (restored by the owner, 2026-11-03). -->
        <receiver
            android:name=".widget.DeviceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_device_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!-- The device widget's picker, when it is placed and from „Einrichten“. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_device_label"
            android:theme="@style/Theme.Haus.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The one energy widget (owner, 2026-11-02): jetzt and heute together. -->
        <receiver
            android:name=".widget.EnergyWidgetProvider"
            android:exported="true"
            android:label="@string/energy_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_widget_info" />
        </receiver>

        <!-- Headless tap handler for a device: the start screen's favorites and the
             app-icon shortcuts (no visible screen). -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- successCallback of requestPinAppWidget (#105): the only place the app
             learns the appWidgetId the host just assigned, so this is where a
             pinned tool widget gets bound. Not exported — it fires only through
             our own PendingIntent, which runs with our identity. -->
        <receiver
            android:name=".widget.WidgetPinReceiver"
            android:exported="false" />

        <!-- taskAffinity="" (#114): without an affinity of its own this dialog
             started INSIDE the app's task, and being translucent it showed
             whatever screen was on top of it — the homescreen when no task
             existed, the last open screen otherwise. Its own task also keeps a
             second action from landing on the first one's. excludeFromRecents
             stays, so the throwaway task never shows up in Recents. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Share → Haus (haus#120): a link or a text from the share sheet, kept
             as a note on Haus, and photos into its document inbox. Exported for
             ACTION_SEND text and ACTION_SEND(_MULTIPLE) images only; translucent
             with its own task, like the widget action dialog (#114). -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- A photo or several from the camera app, into Haus's document inbox
                 (owner, 2026-11-02). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Mehr → Daten sichern (#194): the two folders, the state, „Jetzt
             sichern“, the guide. The folders come through the system picker
             (storage access framework): no storage permission. -->
        <activity
            android:name=".ui.SicherungActivity"
            android:exported="false"
            android:label="@string/sicherung_title"
            android:theme="@style/Theme.Haus" />

        <!-- Mehr → Standortverlauf (owner 2026-11-02): the switch, the mode, Reitti. -->
        <activity
            android:name=".ui.StandortActivity"
            android:exported="false"
            android:label="@string/standort_title"
            android:theme="@style/Theme.Haus" />

        <!-- Standortverlauf: Android's location deliveries, by the app's own
             PendingIntents only; it stores the points and sends a batch when due. -->
        <receiver
            android:name=".standort.StandortEmpfaenger"
            android:exported="false" />

        <!-- WorkManager (the backup job, #194) brings a foreground service of its
             own; the job never goes foreground and posts no notification, so it
             is taken out: LiveService stays the app's one foreground service. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- Generic schema-driven .tool widget (#70): ONE provider that renders any
             tool from the catalog's tool-cell-schema — a new .tool plugin becomes a
             widget with no native code (#72 lists them in the in-app picker). -->
        <receiver
            android:name=".widget.ToolWidgetProvider"
            android:exported="true"
            android:label="@string/tool_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tool_widget_info" />
        </receiver>

        <!-- Collection service backing the tool widget's scrollable row list (#70). -->
        <service
            android:name=".widget.ToolRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Binds a placed tool widget to one tool-id from the live catalog (#70). -->
        <activity
            android:name=".widget.ToolWidgetConfigActivity"
            android:exported="true"
            android:label="@string/tool_widget_label"
            android:theme="@style/Theme.Haus.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Row target of the tool widget (#70/#90): a collection has ONE pending-
             intent template, so every row tap lands here and offers the row's
             actions (POST /napi/action-callback, with the server's confirm gate).
             Invisible; no layout is set. -->
        <activity
            android:name=".widget.ToolActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The live widgets: holds /napi/portal/events while the screen is on.
             specialUse: Android 15 caps the data-sync type at 6 hours a day. -->
        <service
            android:name=".realtime.LiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A live widget connection to the user's own Haus server: while the screen is on, it keeps the home-screen widgets showing the current state of the household." />
        </service>

        <!-- Starts the live widgets again after a reboot and after an app update. -->
        <receiver
            android:name=".realtime.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The configure step of the fed widgets without a choice: no UI, it starts
             the live service (an allowed start) and confirms at once. -->
        <activity
            android:name=".widget.LiveConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
