<?xml version="1.0" encoding="utf-8"?>
<!-- Haus (#176, laib ADR 0022): home-screen widgets and pairing, nothing else.
     One foreground service keeps the widgets live while the screen is on; no
     other notification, no poll, no web shell. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The camera widget's capture screen (#36). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- The live widgets (realtime/LiveService.kt): one specialUse foreground service,
         its notification (shown on Android 13+ only with the permission), its restart after boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exempt from battery optimization, the restart of the live service after its
         process died may go foreground on Android 12+ (asked once after pairing). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 11+ package visibility: the Custom Tabs provider for pairing. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haus">

        <!-- The app's one screen: pairing, then the widgets. It also takes the
             redirect from Haus's /pair-device, cloud.dopp.haus://pair#token=….
             The setup QR is scanned in-app and has NO intent filter: a link
             from any web page could otherwise point the app at a foreign server. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/appName">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cloud.dopp.haus" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- Universal device widget (#4). -->

        <receiver
            android:name=".widget.DeviceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_device_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!-- House energy widget (#8). -->
        <receiver
            android:name=".widget.EnergyWidgetProvider"
            android:exported="true"
            android:label="@string/energy_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_widget_info" />
        </receiver>

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_device_label"
            android:theme="@style/Theme.Haus.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Headless tap handler for the device widget (no visible screen). -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- successCallback of requestPinAppWidget (#105): the only place the app
             learns the appWidgetId the host just assigned, so this is where a
             pinned tool widget gets bound. Not exported — it fires only through
             our own PendingIntent, which runs with our identity. -->
        <receiver
            android:name=".widget.WidgetPinReceiver"
            android:exported="false" />

        <!-- taskAffinity="" (#114): without an affinity of its own this dialog
             started INSIDE the app's task, and being translucent it showed
             whatever screen was on top of it — the homescreen when no task
             existed, the last open screen otherwise. Its own task also keeps a
             second action from landing on the first one's. excludeFromRecents
             stays, so the throwaway task never shows up in Recents. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />



        <!-- Energy statistics widget (#9): 48h house-consumption sparkline. -->
        <receiver
            android:name=".widget.EnergyStatsWidgetProvider"
            android:exported="true"
            android:label="@string/stats_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_stats_widget_info" />
        </receiver>

        <!-- Active-devices overview widget (#28): which devices are on/open. -->
        <receiver
            android:name=".widget.ActiveDevicesWidgetProvider"
            android:exported="true"
            android:label="@string/active_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/active_devices_widget_info" />
        </receiver>

        <!-- Collection service backing the scrollable active-devices ListView (#28). -->
        <service
            android:name=".widget.ActiveDevicesRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Camera snapshot widget (#30): a bound camera's current frame. -->
        <receiver
            android:name=".widget.CameraWidgetProvider"
            android:exported="true"
            android:label="@string/camera_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/camera_widget_info" />
        </receiver>

        <!-- Native camera capture + upload screen (#36): opened by the camera
             trigger widget; takes photos, optionally builds a PDF, uploads to /napi. -->
        <activity
            android:name=".ui.CameraCaptureActivity"
            android:exported="false"
            android:label="@string/camera_capture_title"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Haus" />


        <!-- Devices tile (#167): one tap to the household start page. -->
        <receiver
            android:name=".widget.DevicesWidgetProvider"
            android:exported="true"
            android:label="@string/devices_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/devices_widget_info" />
        </receiver>


        <!-- Energy totals widget (#16): 2x2 kWh totals grid (Gesamt). -->
        <receiver
            android:name=".widget.EnergyTotalsWidgetProvider"
            android:exported="true"
            android:label="@string/totals_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_totals_widget_info" />
        </receiver>



        <!-- Box overview widget (#42): the Box's summary from /napi/box/home. -->
        <receiver
            android:name=".widget.BoxOverviewWidgetProvider"
            android:exported="true"
            android:label="@string/box_overview_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/box_overview_widget_info" />
        </receiver>

        <!-- Box service-status summary widget (#44): healthy/warning/failure. -->
        <receiver
            android:name=".widget.BoxServicesWidgetProvider"
            android:exported="true"
            android:label="@string/box_services_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/box_services_widget_info" />
        </receiver>

        <!-- Generic schema-driven .tool widget (#70): ONE provider that renders any
             tool from the catalog's tool-cell-schema — a new .tool plugin becomes a
             widget with no native code (#72 lists them in the in-app picker). -->
        <receiver
            android:name=".widget.ToolWidgetProvider"
            android:exported="true"
            android:label="@string/tool_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tool_widget_info" />
        </receiver>

        <!-- Collection service backing the tool widget's scrollable row list (#70). -->
        <service
            android:name=".widget.ToolRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Binds a placed tool widget to one tool-id from the live catalog (#70). -->
        <activity
            android:name=".widget.ToolWidgetConfigActivity"
            android:exported="true"
            android:label="@string/tool_widget_label"
            android:theme="@style/Theme.Haus.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Row target of the tool widget (#70/#90): a collection has ONE pending-
             intent template, so every row tap lands here and offers the row's
             actions (POST /napi/action-callback, with the server's confirm gate).
             Invisible; no layout is set. -->
        <activity
            android:name=".widget.ToolActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />






        <!-- Share captured photos with the system camera app for ACTION_IMAGE_CAPTURE
             (#36). Authority mirrors the fileprovider used by FileProvider.getUriForFile. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- The live widgets: holds /napi/portal/events while the screen is on.
             specialUse: Android 15 caps the data-sync type at 6 hours a day. -->
        <service
            android:name=".realtime.LiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A live widget connection to the user's own Haus server: while the screen is on, it keeps the home-screen widgets showing the current state of the household." />
        </service>

        <!-- Starts the live widgets again after a reboot and after an app update. -->
        <receiver
            android:name=".realtime.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The configure step of the fed widgets without a choice: no UI, it starts
             the live service (an allowed start) and confirms at once. -->
        <activity
            android:name=".widget.LiveConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
