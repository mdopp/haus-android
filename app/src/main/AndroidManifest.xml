<?xml version="1.0" encoding="utf-8"?>
<!-- Homes (#176, laib ADR 0022): the start screen with the favorite devices,
     home-screen widgets and pairing, and the daily
     pick-up of the phone's message backups (#194, laib ADR 0029).
     One foreground service keeps the widgets live while the screen is on; no
     other notification, no poll, no web shell. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The live widgets (realtime/LiveService.kt): one specialUse foreground service,
         its notification (shown on Android 13+ only with the permission), its restart after boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Exempt from battery optimization, the restart of the live service after its
         process died may go foreground on Android 12+ (asked once after pairing). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Kontakte, SMS und Anrufe (laib ADR 0029): optional, each asked for only when
         its switch on „Daten sichern“ is turned on; read only. On Android 13+
         a sideloaded app must first be allowed "restricted settings" for SMS and calls. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Standortverlauf (owner 2026-11-02): optional, asked for only when its switch is
         turned on. The location, in the background too („Immer zulassen“), from
         Android's own LocationManager (no Google Play services); the network state
         to know whether it is on a Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Das Homes-Konto (#206, owner 2026-11-03): the household's shared contacts and
         calendars in an account „Homes“, each part asked for only when its switch is
         turned on. The app writes into its own account only; its sync adapters run
         when Android's SyncManager says, hourly at most, and never send anything back. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- whether a sync runs, for the line under „Jetzt abgleichen“: Android answers
         isSyncActive/isSyncPending only with it, else a SecurityException (the crash
         on the button, v3.0.2-dev.269). A normal permission, granted at install. -->
    <uses-permission android:name="android.permission.READ_SYNC_STATS" />

    <!-- Android 11+ package visibility: the Custom Tabs provider for pairing. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.Homes">

        <!-- The app's one screen: pairing, then the widgets. It also takes the
             redirect from Homes' /pair-device, cloud.dopp.homes://pair#token=….
             The setup QR is scanned in-app and has NO intent filter: a link
             from any web page could otherwise point the app at a foreign server. -->
        <activity
            android:name=".ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/appName">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The share target of the assistant's sharing shortcut (#188). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cloud.dopp.homes" android:host="pair" />
            </intent-filter>
        </activity>
        <!-- One device per widget (restored by the owner, 2026-11-03). -->
        <receiver
            android:name=".widget.DeviceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_device_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!-- The device widget's picker, when it is placed and from „Einrichten“. -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_device_label"
            android:theme="@style/Theme.Homes.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The one energy widget (owner, 2026-11-02): jetzt and heute together. -->
        <receiver
            android:name=".widget.EnergyWidgetProvider"
            android:exported="true"
            android:label="@string/energy_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/energy_widget_info" />
        </receiver>

        <!-- Headless tap handler for a device: the start screen's favorites and the
             app-icon shortcuts (no visible screen). -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- successCallback of requestPinAppWidget (#105): the only place the app
             learns the appWidgetId the host just assigned, so this is where a
             pinned tool widget gets bound. Not exported — it fires only through
             our own PendingIntent, which runs with our identity. -->
        <receiver
            android:name=".widget.WidgetPinReceiver"
            android:exported="false" />

        <!-- taskAffinity="" (#114): without an affinity of its own this dialog
             started INSIDE the app's task, and being translucent it showed
             whatever screen was on top of it — the homescreen when no task
             existed, the last open screen otherwise. Its own task also keeps a
             second action from landing on the first one's. excludeFromRecents
             stays, so the throwaway task never shows up in Recents. -->
        <activity
            android:name=".widget.WidgetActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Share → Homes (homes#120): a link or a text from the share sheet, kept
             as a note on Homes, and photos into its document inbox; translucent
             with its own task, like the widget action dialog (#114). Exported, as
             it was, for an explicit start (e2e/live_e2e.sh); the share sheet's two
             entries and their Direct Share targets (res/xml/shortcuts.xml) are the aliases below, one component per target, so each one
             follows what the box offers (homes ADR 0001 §3, kann/Teilen.kt). -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- `merken`: a link or a text, kept as a note. -->
        <activity-alias
            android:name=".ui.TeilenMerken"
            android:targetActivity=".ui.ShareActivity"
            android:exported="true"
            android:label="@string/share_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- `dokument`: a photo or several from the camera app, into Homes'
             document inbox (owner, 2026-11-02). -->
        <activity-alias
            android:name=".ui.TeilenDokument"
            android:targetActivity=".ui.ShareActivity"
            android:exported="true"
            android:label="@string/share_label">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity-alias>

        <!-- Share → „In den Standortverlauf übernehmen“ (owner 2026-11-03): an old
             location history file (Google Maps' Timeline.json, Takeout's
             Records.json, GPX, GeoJSON) into the person's Reitti, through Homes.
             Exported for ACTION_SEND of those types only; a file manager that
             says octet-stream is checked by its name (.json, .geojson, .gpx).
             Translucent with its own task, like ShareActivity. -->
        <activity
            android:name=".ui.StandortImportActivity"
            android:exported="true"
            android:label="@string/standort_import_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Mehr → Daten sichern (#194): the two folders, the state, „Jetzt
             sichern“, the guide. The folders come through the system picker
             (storage access framework): no storage permission. -->
        <activity
            android:name=".ui.SicherungActivity"
            android:exported="false"
            android:label="@string/sicherung_title"
            android:theme="@style/Theme.Homes" />

        <!-- Sicherung zurückholen (homes-android#197): the newest Signal and WhatsApp
             backup from the box onto a new phone, into folders granted with write access. -->
        <activity
            android:name=".ui.ZurueckholenActivity"
            android:exported="false"
            android:label="@string/zurueck_title"
            android:theme="@style/Theme.Homes" />

        <!-- Mehr → Standortverlauf (owner 2026-11-02): the switch, the mode, Reitti. -->
        <activity
            android:name=".ui.StandortActivity"
            android:exported="false"
            android:label="@string/standort_title"
            android:theme="@style/Theme.Homes" />

        <!-- Mehr → Homes auf dem Handy (#206): the two switches of the Homes account.
             Exported without a filter: Android's settings open it on „Konto hinzufügen → Homes“. -->
        <activity
            android:name=".ui.HomesKontoActivity"
            android:exported="true"
            android:label="@string/konto_title"
            android:theme="@style/Theme.Homes" />

        <!-- The Homes account (#206): its authenticator and its two sync adapters,
             bound by Android only (the permissions say so), none foreground. -->
        <service
            android:name=".konto.KontoDienst"
            android:exported="true"
            android:permission="android.permission.ACCOUNT_MANAGER">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/konto" />
        </service>
        <service
            android:name=".konto.KontakteSyncDienst"
            android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/kontakte_sync" />
            <meta-data
                android:name="android.provider.CONTACTS_STRUCTURE"
                android:resource="@xml/kontakte_konto" />
        </service>
        <service
            android:name=".konto.KalenderSyncDienst"
            android:exported="true"
            android:permission="android.permission.BIND_SYNC_ADAPTER">
            <intent-filter>
                <action android:name="android.content.SyncAdapter" />
            </intent-filter>
            <meta-data
                android:name="android.content.SyncAdapter"
                android:resource="@xml/kalender_sync" />
        </service>

        <!-- Standortverlauf: Android's location deliveries, by the app's own
             PendingIntents only; it stores the points and sends a batch when due. -->
        <receiver
            android:name=".standort.StandortEmpfaenger"
            android:exported="false" />

        <!-- WorkManager (the backup job, #194) brings a foreground service of its
             own; the job never goes foreground and posts no notification, so it
             is taken out: LiveService stays the app's one foreground service. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- Generic schema-driven .tool widget (#70): ONE provider that renders any
             tool from the catalog's tool-cell-schema — a new .tool plugin becomes a
             widget with no native code (#72 lists them in the in-app picker). -->
        <receiver
            android:name=".widget.ToolWidgetProvider"
            android:exported="true"
            android:label="@string/tool_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tool_widget_info" />
        </receiver>

        <!-- Collection service backing the tool widget's scrollable row list (#70). -->
        <service
            android:name=".widget.ToolRemoteViewsService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Binds a placed tool widget to one tool-id from the live catalog (#70). -->
        <activity
            android:name=".widget.ToolWidgetConfigActivity"
            android:exported="true"
            android:label="@string/tool_widget_label"
            android:theme="@style/Theme.Homes.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Row target of the tool widget (#70/#90): a collection has ONE pending-
             intent template, so every row tap lands here and offers the row's
             actions (POST /napi/action-callback, with the server's confirm gate).
             Invisible; no layout is set. -->
        <activity
            android:name=".widget.ToolActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- The live widgets: holds /napi/portal/events while the screen is on.
             specialUse: Android 15 caps the data-sync type at 6 hours a day. -->
        <service
            android:name=".realtime.LiveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A live widget connection to the user's own Homes server: while the screen is on, it keeps the home-screen widgets showing the current state of the household." />
        </service>

        <!-- Starts the live widgets again after a reboot and after an app update. -->
        <receiver
            android:name=".realtime.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- The configure step of the fed widgets without a choice: no UI, it starts
             the live service (an allowed start) and confirms at once. -->
        <activity
            android:name=".widget.LiveConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
