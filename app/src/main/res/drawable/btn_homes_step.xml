<?xml version="1.0" encoding="utf-8"?>
<!-- A quick level in the level sheet (owner, 2026-11-03): an accent tint, as on Homes' sheet. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/homes_accent_step_pressed" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/homes_accent_step" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
