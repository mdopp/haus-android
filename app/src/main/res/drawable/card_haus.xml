<?xml version="1.0" encoding="utf-8"?>
<!-- Tiered Haus card: subtle vertical gradient + hairline edge, matching the
     widgets' rounded look; the widgets themselves are solid black since 2026-11-03. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FF17171D"
        android:endColor="#FF0D0D11" />
    <corners android:radius="@dimen/radius_lg" />
    <stroke android:width="1dp" android:color="@color/haus_card_edge" />
</shape>
