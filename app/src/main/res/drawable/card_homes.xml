<?xml version="1.0" encoding="utf-8"?>
<!-- Tiered Homes card: a subtle vertical gradient, no edge (owner, 2026-11-04, as
     Homes' pages since mdopp/homes#271: the card's surface separates it; rows keep
     their dividers, fields and buttons their edge). The widgets are solid black since 2026-11-03. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FF17171D"
        android:endColor="#FF0D0D11" />
    <corners android:radius="@dimen/radius_lg" />
</shape>
