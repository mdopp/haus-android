<?xml version="1.0" encoding="utf-8"?>
<!-- Shared filled brand-blue circle behind a trigger-tile glyph (#54).
     Used by every "öffnet X" tile (camera, devices) so they read identically —
     a gradient oval signalling "antippen".

     Painted from the brand blue, NOT from the shell accent (#130): these tiles
     are home-screen widgets, sitting among foreign icons rather than beside the
     web surface, so the seam argument that turned the in-app accent orange does
     not apply to them. The in-app camera page reuses the same circle so a
     captured page and the widget that triggered it still read as one thing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="90"
        android:startColor="@color/haus_brand_blue"
        android:endColor="@color/haus_brand_blue_dark" />
</shape>
