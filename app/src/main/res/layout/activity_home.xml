<?xml version="1.0" encoding="utf-8"?>
<!-- The app's one screen (#176): pair with Haus, then add widgets. targetSdk 35
     draws edge-to-edge, so HomeActivity adds the system-bar insets onto the
     root's padding; the root carries an id for that. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/haus_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <!-- The persona: icon, name, a rule in its accent (from /napi/persona). -->
        <LinearLayout
            android:id="@+id/persona_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/persona_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginBottom="@dimen/space_sm"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/persona_name"
                style="@style/Text.Haus.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appName" />

            <View
                android:id="@+id/persona_rule"
                android:layout_width="52dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@color/haus_accent" />

            <TextView
                android:id="@+id/persona_greeting"
                style="@style/Text.Haus.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_horizontal"
                android:text="@string/home_claim" />
        </LinearLayout>

        <!-- Unpaired: Haus's address, then /pair-device. -->
        <LinearLayout
            android:id="@+id/connect_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_haus"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:id="@+id/connect_hint"
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/home_connect_hint" />

            <EditText
                android:id="@+id/server_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/home_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true" />

            <Button
                android:id="@+id/connect_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/home_connect" />

            <Button
                android:id="@+id/qr_scan_btn"
                style="@style/Widget.Haus.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/qr_scan" />
        </LinearLayout>

        <!-- Paired: where to, and the widgets to add. -->
        <LinearLayout
            android:id="@+id/connected_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/status"
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:gravity="center_horizontal" />

            <!-- The live widgets (LiveService): on by default once paired. -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/live_switch"
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/live_switch" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_widgets_title" />

            <TextView
                style="@style/Text.Haus.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/home_widgets_hint" />

            <LinearLayout
                android:id="@+id/widgets_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_haus"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tools_group_title"
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/home_widgets_group_tools"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tools_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_haus"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/home_widgets_group_box" />

            <TextView
                style="@style/Text.Haus.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/home_box_hint" />

            <LinearLayout
                android:id="@+id/box_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_haus"
                android:orientation="vertical" />

            <Button
                android:id="@+id/logout_btn"
                style="@style/Widget.Haus.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/home_logout" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_version"
            style="@style/Text.Haus.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/app_version_placeholder" />
    </LinearLayout>
</ScrollView>
