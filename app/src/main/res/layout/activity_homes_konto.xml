<?xml version="1.0" encoding="utf-8"?>
<!-- Mehr → Homes auf dem Handy (#206): the Homes account's two switches, each with
     its permission and its last state, „Jetzt abgleichen“, and which way is which. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/konto_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/homes_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Text.Homes.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/konto_title" />

        <TextView
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/konto_intro" />

        <TextView
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textColor="@color/homes_text_muted"
            android:text="@string/konto_nur_lesen" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/konto_kontakte_titel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/konto_kontakte_an"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/konto_kontakte_schalter" />
            </LinearLayout>

            <TextView
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/konto_kontakte_was" />

            <!-- the last good run, or what went wrong; a tap on a missing permission opens App-Info -->
            <TextView
                android:id="@+id/konto_kontakte_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/homes_text_muted"
                android:visibility="gone" />
            <!-- What the box lacks here (homes ADR 0001 §10): the part's trace, below its disabled switch. -->
            <LinearLayout
                android:id="@+id/konto_kontakte_spur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_homes"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Homes.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/konto_kalender_titel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/konto_kalender_an"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/konto_kalender_schalter" />
            </LinearLayout>

            <TextView
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/konto_kalender_was" />

            <!-- the last good run, or what went wrong; a tap on a missing permission opens App-Info -->
            <TextView
                android:id="@+id/konto_kalender_stand"
                style="@style/Text.Homes.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/homes_text_muted"
                android:visibility="gone" />
            <!-- What the box lacks here (homes ADR 0001 §10): the part's trace, below its disabled switch. -->
            <LinearLayout
                android:id="@+id/konto_kalender_spur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/konto_jetzt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/konto_jetzt" />

        <TextView
            android:id="@+id/konto_zustand"
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <TextView
            style="@style/Text.Homes.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textColor="@color/homes_text_muted"
            android:text="@string/konto_andere_richtung" />
    </LinearLayout>
</ScrollView>
