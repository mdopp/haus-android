<?xml version="1.0" encoding="utf-8"?>
<!-- Mehr → Nachrichten sichern (#194): the two folders, the cards with the
     switches for contacts and for SMS and calls (laib ADR 0029), the state, „Jetzt
     sichern“, and the guide. Edge-to-edge like the home screen. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sicherung_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/haus_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            style="@style/Text.Haus.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/sicherung_title" />

        <TextView
            style="@style/Text.Haus.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sicherung_intro" />

        <TextView
            android:id="@+id/sicherung_frei"
            style="@style/Text.Haus.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <include
            android:id="@+id/sicherung_whatsapp"
            layout="@layout/item_sicherung_quelle" />

        <include
            android:id="@+id/sicherung_signal"
            layout="@layout/item_sicherung_quelle" />

        <!-- Kontakte (laib ADR 0029): a card like WhatsApp's and Signal's, the switch
             in its title row, off until the person turns it on. -->
        <LinearLayout
            android:id="@+id/handy_kontakte_karte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_haus"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Haus.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/handy_kontakte_titel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/handy_kontakte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/handy_kontakte" />
            </LinearLayout>

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/handy_kontakte_was" />

            <TextView
                android:id="@+id/handy_kontakte_stand"
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Why it is off or what went wrong; a tap opens App-Info when the way is through there. -->
            <TextView
                android:id="@+id/handy_kontakte_meldung"
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/haus_accent"
                android:visibility="gone" />
        </LinearLayout>

        <!-- SMS und Anrufe (laib ADR 0029): a card like WhatsApp's and Signal's, the switch
             in its title row, off until the person turns it on. -->
        <LinearLayout
            android:id="@+id/handy_sms_karte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/card_haus"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Haus.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/handy_sms_titel" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/handy_sms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/handy_sms" />
            </LinearLayout>

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/handy_sms_was" />

            <TextView
                android:id="@+id/handy_sms_stand"
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Why it is off or what went wrong; a tap opens App-Info when the way is through there. -->
            <TextView
                android:id="@+id/handy_sms_meldung"
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/haus_accent"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/sicherung_jetzt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/sicherung_jetzt" />

        <ProgressBar
            android:id="@+id/sicherung_balken"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:max="1000"
            android:progressTint="@color/haus_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sicherung_zustand"
            style="@style/Text.Haus.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/sicherung_ruht" />

        <TextView
            style="@style/Text.Haus.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/sicherung_anleitung_title" />

        <LinearLayout
            android:id="@+id/sicherung_anleitung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/card_haus"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_whatsapp_title" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/sicherung_anleitung_whatsapp" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_signal_title" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/sicherung_anleitung_signal" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_ordner_title" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/sicherung_anleitung_ordner" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_kontakte_title" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/sicherung_anleitung_kontakte" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_sms_title" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/sicherung_anleitung_sms" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_discord_title" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/sicherung_anleitung_discord" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/sicherung_anleitung_versionen" />

            <TextView
                style="@style/Text.Haus.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_nie_title" />

            <TextView
                style="@style/Text.Haus.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sicherung_anleitung_nie" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
