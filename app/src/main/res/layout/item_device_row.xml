<?xml version="1.0" encoding="utf-8"?>
<!-- A favorite device on the start screen: its icon, name and state; a tap switches it.
     Below them its fine controls (owner, 2026-11-03), filled by HomeActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="18dp"
        android:tint="@color/haus_text_muted"
        android:src="@drawable/ic_device"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/haus_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/row_room"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:textColor="@color/haus_text_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/row_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
