<?xml version="1.0" encoding="utf-8"?>
<!-- A favourite as a tile, two to a row (owner, 2026-11-04, variant A2): the widgets'
     picture says the state (a lamp lit or dark, a blind up, part-way or down, the garage
     door open or shut) on a round of its colour, its level beside it („32 %“, „aus“ — a
     tap opens the level sheet), the name below. Words only where the picture cannot say
     it („öffnet …“, „nicht erreichbar“, a heating's reading). No outline; the ground
     takes a wash of the state's colour while the thing is on or open. FavoritenAnsicht fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tile_homes"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/dot_homes"
            android:src="@drawable/ic_device"
            android:contentDescription="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <cloud.dopp.homes.ui.LevelText
            android:id="@+id/row_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp"
            android:maxLines="1"
            android:textColor="@color/homes_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFeatureSettings="tnum"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeMaxTextSize="15sp"
        android:textColor="@color/homes_text"
        android:textStyle="bold"
        android:textSize="15sp" />

    <!-- Only where the picture cannot say it, and „schaltet …“ after a tap. -->
    <TextView
        android:id="@+id/row_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/homes_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- A heating's or a player's buttons as pictures; a cover keeps its in the level sheet. -->
    <LinearLayout
        android:id="@+id/row_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
