<?xml version="1.0" encoding="utf-8"?>
<!-- A quiet trace (homes ADR 0001 §10): what the box does not have yet, in the
     row look of item_widget_type, grey only — no red, no warning sign. Below the
     title where it stands, then „Hier anfordern“ while Homes offers it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/spur_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="18dp"
        app:tint="@color/homes_text_faint"
        android:src="@drawable/ic_services"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/spur_titel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/homes_text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/spur_stand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/homes_text_faint"
            android:textSize="13sp" />

        <!-- How a request ended when not as wished: Homes' sentence, or the app's. -->
        <TextView
            android:id="@+id/spur_satz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/homes_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/spur_anfordern"
        style="@style/Widget.Homes.Button.Control"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:minHeight="48dp"
        android:text="@string/anfordern"
        android:visibility="gone" />
</LinearLayout>
