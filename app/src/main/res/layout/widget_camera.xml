<?xml version="1.0" encoding="utf-8"?>
<!-- Camera trigger tile (#36): unified trigger-tile pattern (#54) — a filled
     accent circle (52dp) with a white camera glyph + a single bold "Kamera"
     label. Structurally identical to the devices tile (widget_devices.xml); only
     the glyph + word differ. A tap opens the app's capture screen. RemoteViews-safe
     (LinearLayout / ImageView / TextView only — no plain <View>). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cam_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <ImageView
        android:id="@+id/cam_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/tile_accent_circle"
        android:padding="12dp"
        android:src="@drawable/ic_camera"
        android:tint="#FFFFFFFF"
        android:contentDescription="@string/camera_widget_label" />

    <TextView
        android:id="@+id/cam_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/camera_widget_label"
        android:textColor="@color/haus_text"
        android:textStyle="bold"
        android:textSize="13sp" />
</LinearLayout>
