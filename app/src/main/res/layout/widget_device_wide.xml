<?xml version="1.0" encoding="utf-8"?>
<!-- One device, two cells or more wide (owner, 2026-11-03): the picture on
     the left as high as the cell, the name and the state beside it. The same
     ids as widget_device.xml, so DeviceWidgetProvider draws both alike. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/d_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/d_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/d_icon"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_device"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/widget_device_label"
                android:textColor="#FFF2F2F5"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/d_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="13sp"
                android:text="—"
                android:textColor="#FF9AA0AE"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/d_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="60"
                android:progressTint="#FFFFC107"
                android:progressBackgroundTint="#26FFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
