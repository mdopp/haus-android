<?xml version="1.0" encoding="utf-8"?>
<!-- The one energy widget (owner, 2026-11-03, after the first version on his
     phone): one frame, no inner boxes, and the content fills the cell. „Jetzt“,
     the four flow legs, two rows of two, each its word and its value; „Heute“, what the counters added since
     midnight, two rows of two — hidden while Homes does not say. Green only for
     what the sun makes and what goes into the grid; consumption is neutral.
     No capitals. A tap opens Homes' /energie; the arrows read again. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/e_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/e_now_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/e_now_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/energy_now"
                android:textColor="#FFF2F2F5"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/e_refresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="5dp"
                android:src="@drawable/ic_refresh"
                android:tint="#FF9AA0AE"
                android:contentDescription="@string/widget_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_now_l0" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_now_v0" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_now_l1" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_now_v1" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_now_l2" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_now_v2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_now_l3" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_now_v3" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/e_today_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/e_today_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="@string/energy_today"
            android:textColor="#FFF2F2F5"
            android:textStyle="bold"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_today_l0" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_today_v0" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_today_l1" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_today_v1" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_today_l2" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_today_v2" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingEnd="8dp">
                <TextView android:id="@+id/e_today_l3" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="#FF9AA0AE" android:textSize="13sp" />
                <TextView android:id="@+id/e_today_v3" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="4dp"
                    android:maxLines="1" android:text="—" android:textColor="#FFF2F2F5"
                    android:textStyle="bold" android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
