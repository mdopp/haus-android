<?xml version="1.0" encoding="utf-8"?>
<!-- The energy widget, two cells high and more (owner, 2026-11-03: „Grafiken
     könnten helfen es besser zu verstehen. Und ein aktueller Akkustand“): the
     flow now as a picture like Haus's Energie page (EnergyPicture: Solar,
     Netz, Akku with its charge as a ring, Haus, the active ways drawn), and
     beside it, with the room and while Haus says it, what the counters added
     today in the ways' colours, and the Autarkie now. The tap sits on e_root,
     a child filling the tile (#104); no reload arrows, the live stream keeps
     it current (owner, 2026-11-03). Heavy type, no capitals. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/e_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/e_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/e_flow"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:contentDescription="@string/energy_widget_label" />

        <!-- Heute (owner, 2026-11-03): the number first, then its word; the
             numbers end and the words begin on one axis down the middle of
             the column, „Heute“ centred over it. Autarkie now is the last row. -->
        <LinearLayout
            android:id="@+id/e_today_block"
            android:layout_width="@dimen/energy_today_width"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/e_today_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/energy_today"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFF2F2F5"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/e_today_v0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="—"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFF2F2F5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/e_today_l0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFC9CDD6"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/e_today_v1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="—"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFF2F2F5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/e_today_l1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFC9CDD6"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/e_today_v2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="—"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFF2F2F5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/e_today_l2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFC9CDD6"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/e_autarkie"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/e_autarkie_v"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="—"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFF2F2F5"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/e_autarkie_l"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:gravity="start"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/energy_autarkie"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFC9CDD6"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Instead of the picture while there is nothing to draw: not paired. -->
    <TextView
        android:id="@+id/e_note"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#FF9AA0AE"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
