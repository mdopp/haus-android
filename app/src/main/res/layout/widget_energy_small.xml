<?xml version="1.0" encoding="utf-8"?>
<!-- The energy widget one cell high (owner, 2026-11-03): a reduced picture —
     the battery with its charge as a ring and in its middle (or, while Haus
     does not say the charge, the grid) — and beside it the grid's direction
     now in words and number; with a little more room the house's draw and a
     line of heute. The tap sits on e_root, a child filling the tile (#104).
     No capitals. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/e_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:id="@+id/e_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/e_ring"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/e_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                                android:maxLines="1"
                android:ellipsize="end"
                android:text="Netz"
                android:textColor="#FF9AA0AE"
                android:fontFamily="sans-serif-black"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/e_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="—"
                android:textColor="#FFF2F2F5"
                android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:id="@+id/e_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFC9CDD6"
                android:textSize="12sp" />

            <!-- Heute, one line: only with a little more room than the bare tier. -->
            <TextView
                android:id="@+id/e_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#FFE3B341"
                android:fontFamily="sans-serif-black"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Four cells wide: the house and Heute beside, instead of below. -->
        <LinearLayout
            android:id="@+id/e_side"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="end"
            android:visibility="gone">

            <TextView
                android:id="@+id/e_side1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FFF2F2F5"
                android:fontFamily="sans-serif-black"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/e_side2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:textColor="#FFE3B341"
                android:fontFamily="sans-serif-black"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
