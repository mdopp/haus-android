<?xml version="1.0" encoding="utf-8"?>
<!-- The share targets behind the assistant's sharing shortcut (#188, widget/ShareTarget.kt):
     a shortcut of the first category hands text/plain to the share activity (`merken`),
     one of the second images (`dokument`); the shortcut names the categories the box
     offers (homes ADR 0001 §3). No static shortcut here: the app icon's menu is dynamic (#97). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="cloud.dopp.homes.ui.ShareActivity">
        <data android:mimeType="text/plain" />
        <category android:name="cloud.dopp.homes.category.SHARE_TO_HOMES" />
    </share-target>
    <share-target android:targetClass="cloud.dopp.homes.ui.ShareActivity">
        <data android:mimeType="image/*" />
        <category android:name="cloud.dopp.homes.category.SHARE_DOKUMENT" />
    </share-target>
</shortcuts>
